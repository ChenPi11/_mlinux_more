#!/bin/sh

set -e

# shellcheck disable=SC2050
if [ "@HTTP_PROXY@" != "" ]; then
    export http_proxy=@HTTP_PROXY@
    export https_proxy=@HTTP_PROXY@
fi

cd /tmp
wget https://github.com/zxcvbnm3057/FastGithub/releases/download/2.1.5/fastgithub_linux-x64.zip
unzip fastgithub_linux-x64.zip
mv fastgithub_linux-x64 /opt/fastgithub
chmod +x /opt/fastgithub/fastgithub
chmod +x /opt/fastgithub/dnscrypt-proxy/dnscrypt-proxy

cat > /usr/lib/systemd/system/fastgithub.service << EOF
[Service]
Type=forking
ExecStart=/opt/fastgithub/fastgithub
EOF

chmod 754 /usr/lib/systemd/system/fastgithub.service

systemctl daemon-reload

systemctl enable fastgithub
